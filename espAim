local function RainbowColor()
	return Color3.fromHSV((tick()*.18)%1,1,1)
end

local function UpdateESP(player,data)
	local character = player.Character

	if not character then
		data.Highlight.Enabled = false
		data.Billboard.Enabled = false
		data.Beam.Enabled = false
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	local myCharacter = LP.Character
	local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

	if not root or not hum or not myRoot then
		data.Highlight.Enabled = false
		data.Billboard.Enabled = false
		data.Beam.Enabled = false
		return
	end

	if hum.Health <= 0 then
		data.Highlight.Enabled = false
		data.Billboard.Enabled = false
		data.Beam.Enabled = false
		return
	end

	local distance = (myRoot.Position-root.Position).Magnitude

	if distance > S.ESP.MaxDistance or not S.ESP.Enabled then
		data.Highlight.Enabled = false
		data.Billboard.Enabled = false
		data.Beam.Enabled = false
		return
	end

	local Color = S.ESP.Rainbow and RainbowColor() or S.ESP.Color

	data.Highlight.Enabled = true
	data.Highlight.Adornee = character
	data.Highlight.FillColor = Color
	data.Highlight.OutlineColor = Color

	data.Billboard.Enabled = true
	data.Billboard.Adornee = root

	local text = ""

	if S.ESP.Name then
		text = player.DisplayName
	end

	if S.ESP.Health then
		text = text .. (text ~= "" and "  " or "") .. "HP: " .. math.floor(hum.Health)
	end

	data.Text.Text = text
	data.Text.TextColor3 = Color

	data.Beam.Enabled = true
	data.TargetAttachment.WorldPosition = root.Position

	local myAttachment = myRoot:FindFirstChild("ESP_MyAttachment")

	if not myAttachment then
		myAttachment = Instance.new("Attachment")
		myAttachment.Name = "ESP_MyAttachment"
		myAttachment.Parent = myRoot
	end

	data.Beam.Attachment0 = myAttachment
	data.Beam.Attachment1 = data.TargetAttachment
	data.Beam.Color = ColorSequence.new(Color)
end

local CurrentTarget = nil

local function IsAlive(character)
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

local function GetPart(character)
	if not character then
		return nil
	end

	local part = character:FindFirstChild(S.Aim.TargetPart)

	if part and part:IsA("BasePart") then
		return part
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function IsVisible(part)
	if not S.Aim.WallCheck then
		return true
	end

	local origin = Camera.CFrame.Position
	local direction = part.Position-origin

	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {LP.Character}

	local Result = workspace:Raycast(origin,direction,Params)

	if not Result then
		return true
	end

	return Result.Instance:IsDescendantOf(part.Parent)
end

local function ValidPlayer(player)
	if player == LP then
		return false
	end

	local character = player.Character

	if not character or not IsAlive(character) then
		return false
	end

	if S.Aim.TeamCheck and player.Team == LP.Team then
		return false
	end

	local part = GetPart(character)

	if not part then
		return false
	end

	local distance = (Camera.CFrame.Position-part.Position).Magnitude

	if distance > S.Aim.MaxDistance then
		return false
	end

	if not IsVisible(part) then
		return false
	end

	local screenPos,onScreen = Camera:WorldToViewportPoint(part.Position)

	if not onScreen then
		return false
	end

	local center = Vector2.new(
		Camera.ViewportSize.X/2,
		Camera.ViewportSize.Y/2
	)

	local point = Vector2.new(screenPos.X,screenPos.Y)
	local screenDistance = (point-center).Magnitude

	if screenDistance > S.Aim.FOV then
		return false
	end

	return true,part,screenDistance,distance
end

local function FindTarget()
	local best = nil
	local bestScore = math.huge

	for _,player in ipairs(Players:GetPlayers()) do
		local valid,part,screenDist,worldDist = ValidPlayer(player)

		if valid then
			local score

			if S.Aim.Priority == "Distance" then
				score = worldDist
			else
				score = screenDist
			end

			if score < bestScore then
				bestScore = score
				best = player
			end
		end
	end

	return best
end

RunService:BindToRenderStep(
	"AIM_CAMERA",
	Enum.RenderPriority.Camera.Value + 2,
	function()
		Camera = workspace.CurrentCamera

		FOVCircle.Position = UDim2.fromOffset(
			Camera.ViewportSize.X/2,
			Camera.ViewportSize.Y/2
		)

		FOVCircle.Size = UDim2.fromOffset(
			S.Aim.FOV*2,
			S.Aim.FOV*2
		)

		FOVCircle.Visible = S.Aim.Enabled
		FOVStroke.Color = S.Aim.FOVColor

		if not S.Aim.Enabled then
			CurrentTarget = nil
		else
			if CurrentTarget then
				local valid = ValidPlayer(CurrentTarget)

				if not valid then
					CurrentTarget = nil
				end
			end

			if not CurrentTarget then
				CurrentTarget = FindTarget()
			end

			if CurrentTarget then
				local part = GetPart(CurrentTarget.Character)

				if part then
					local desired = CFrame.lookAt(
						Camera.CFrame.Position,
						part.Position
					)

					Camera.CFrame = Camera.CFrame:Lerp(
						desired,
						math.clamp(S.Aim.Smoothness,.01,.82)
					)
				end
			end
		end

		for _,player in ipairs(Players:GetPlayers()) do
			if player ~= LP then
				if not ESPObjects[player] then
					CreateESP(player)
				end

				UpdateESP(player,ESPObjects[player])
			end
		end

		Main.BackgroundColor3 = S.UI.MenuColor
		Top.BackgroundColor3 = S.UI.TopColor
		Open.BackgroundColor3 = S.UI.ButtonColor

		for _,page in pairs(Pages) do
			for _,obj in ipairs(page:GetChildren()) do
				if obj:IsA("TextButton") then
					obj.BackgroundColor3 = S.UI.ButtonColor
				end
			end
		end
	end
)

