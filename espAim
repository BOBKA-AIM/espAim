--==================================================
-- FOV RING & LOGIC
--==================================================

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1
FOVCircle.Filled = false
FOVCircle.Transparency = 1

local function GetClosestPlayer()
	local Target = nil
	local ShortestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP and player.Character and player.Character:FindFirstChild(S.Aim.TargetPart) and player.Character:FindFirstChildOfClass("Humanoid") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
			if S.Aim.TeamCheck and player.Team == LP.Team then continue end
			
			local Part = player.Character[S.Aim.TargetPart]
			local Pos, OnScreen = Camera:WorldToViewportPoint(Part.Position)
			
			if OnScreen then
				local Distance = (Vector2.new(Pos.X, Pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
				if Distance <= S.Aim.FOV and Distance < ShortestDistance then
					if S.Aim.WallCheck then
						local RaycastParamsObj = RaycastParams.new()
						RaycastParamsObj.FilterType = Enum.RaycastFilterType.Exclude
						RaycastParamsObj.FilterDescendantsInstances = {LP.Character, player.Character}
						local RaycastResult = workspace:Raycast(Camera.CFrame.Position, Part.Position - Camera.CFrame.Position, RaycastParamsObj)
						if RaycastResult then continue end
					end
					ShortestDistance = Distance
					Target = Part
				end
			end
		end
	end
	return Target
end

--==================================================
-- MAIN LOOP (ESP + AIM FUNCTION)
--==================================================

local HighlightStorage = {}

RunService.RenderStepped:Connect(function()
	-- Обновление FOV кольца
	FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	FOVCircle.Radius = S.Aim.FOV
	FOVCircle.Color = S.Aim.FOVColor
	FOVCircle.Visible = S.Aim.Enabled

	-- Логика Аима
	if S.Aim.Enabled and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local Target = GetClosestPlayer()
		if Target then
			local TargetPos = Camera:WorldToViewportPoint(Target.Position)
			local MousePos = UIS:GetMouseLocation()
			Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, Target.Position), S.Aim.Smoothness)
		end
	end

	-- Логика ESP
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP and player.Character then
			local char = player.Character
			if S.ESP.Enabled then
				if S.Aim.TeamCheck and player.Team == LP.Team then
					if HighlightStorage[player] then HighlightStorage[player]:Destroy() HighlightStorage[player] = nil end
					continue
				end
				
				local highlight = HighlightStorage[player]
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Parent = char
					HighlightStorage[player] = highlight
				end
				
				highlight.FillColor = S.ESP.Rainbow and Color3.fromHSV(tick() % 5 / 5, 1, 1) or S.ESP.Color
				highlight.OutlineColor = Color3.new(1,1,1)
				highlight.FillTransparency = 0.5
				highlight.OutlineTransparency = 0
			else
				if HighlightStorage[player] then
					HighlightStorage[player]:Destroy()
					HighlightStorage[player] = nil
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	if HighlightStorage[player] then
		HighlightStorage[player]:Destroy()
		HighlightStorage[player] = nil
	end
end)

