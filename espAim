local function Button(parent,text)
	local B = Instance.new("TextButton")
	B.Size = UDim2.new(1,0,0,34)
	B.BackgroundColor3 = S.UI.ButtonColor
	B.Text = text
	B.TextColor3 = Color3.fromRGB(225,225,230)
	B.TextSize = 11
	B.Font = Enum.Font.GothamMedium
	B.AutoButtonColor = false
	B.Parent = parent

	local C = Instance.new("UICorner")
	C.CornerRadius = UDim.new(0,7)
	C.Parent = B

	return B
end

local function Toggle(parent,text,value,callback)
	local B = Button(parent,text..": "..(value and "ON" or "OFF"))
	B.Activated:Connect(function()
		value = not value
		B.Text = text..": "..(value and "ON" or "OFF")
		callback(value)
	end)
	return B
end

local function Cycle(parent,text,values,index,callback)
	local B = Button(parent,text..": "..tostring(values[index]))
	B.Activated:Connect(function()
		index = index + 1
		if index > #values then index = 1 end
		B.Text = text..": "..tostring(values[index])
		callback(values[index])
	end)
	return B
end

